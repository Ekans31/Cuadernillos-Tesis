14ff8a537197"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Mu]", ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{"rh", ":=", 
  RowBox[{"Sqrt", "[", "\[Mu]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rStar", "[", "r_", "]"}], ":=", 
    RowBox[{"r", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"rh", "/", "2"}], ")"}], "*", 
      RowBox[{"Log", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "-", "rh"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"r", "+", "rh"}], ")"}]}], "]"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Trayectorias", " ", "de", " ", "luz", " ", "en", " ", "Schwarzschild", " ",
     "5", "D", 
    RowBox[{"(", 
     RowBox[{"t", " ", "vs", " ", "r"}], ")"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"t", "=", 
    RowBox[{
     RowBox[{"constant", "\\", "pm"}], " ", "r", "*"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Sch5Dout", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"rStar", "[", "r", "]"}], "+", "c"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"rStar", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"-", "20"}], ",", "20", ",", "1"}], "}"}]}], "]"}], "]"}], ",", 
