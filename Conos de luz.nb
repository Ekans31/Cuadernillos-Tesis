      RowBox[{"r", ",", 
       RowBox[{"rOuter", "+", "0.001"}], ",", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"F35Dout", "=", 
