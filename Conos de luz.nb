Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rh", "=", 
   RowBox[{"Sqrt", "[", "\[Mu]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tin", "[", 
     RowBox[{"r_", ",", "c_"}], "]"}], ":=", 
    RowBox[{"c", "-", "r"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tout", "[", 
    RowBox[{"r_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"c", "+", "r", "+", 
    RowBox[{"rh", "*", 
     RowBox[{"Log", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "-", "rh"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"r", "+", "rh"}], ")"}]}], "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "6"}], ",", "6", ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"singularity", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.03", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"10", " ", "t"}], "]"}]}], ",", "t"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "4"}], ",", "4", ",", "0.1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Sch5Din", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tout", "[", 
          RowBox[{"r", ",", "c"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "cs"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tin", "[", 
          RowBox[{"r", ",", "c"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "cs"}], "}"}]}], "]"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "4"}], "}"}], ",", 
    RowBox[{"Exclusions", "->", 
     RowBox[{"{", 
      RowBox[{"r", "==", "rh"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "-", "0.07"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"FontSize", "->", "16"}], "]"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", "r", "]"}], ",", "18"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"TraditionalForm", "[", "Singularity", "]"}], ",", "18"}], 
         "]"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"FrameTicks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"None", ",", "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"rh", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(h\)]\)\>\"", ",", 
              "12"}], "]"}]}], "}"}], "}"}], ",", "None"}], "}"}]}], "}"}]}], 
    ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.8", "]"}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "cs", "]"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.8", "]"}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "cs", "]"}], "}"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "rh", "}"}], ",", "None"}], "}"}]}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Black", ",", "Thick", ",", 
         RowBox[{"Line", "[", "singularity", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dashed", ",", "Thick", ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rh", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"rh", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
