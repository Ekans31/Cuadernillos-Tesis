Cell["Observador dentro del agujero negro", "Subsection",
 CellChangeTimes->{{3.983005975061592*^9, 
  3.9830059857063885`*^9}},ExpressionUUID->"db158a81-083d-de42-a82f-\
c3e7b9347c0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "2"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Integrando", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Int", "[", 
     RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"r", "^", "2"}], "-", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Horizonte", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rh", "=", 
   RowBox[{
    RowBox[{"r", "/.", " ", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "+", 
         RowBox[{"r", "^", "2"}], "-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}], "==", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1"}], "}"}]}], "]"}]}], "//", "N"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Coordenadas", " ", "nulas"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tin", "[", 
     RowBox[{"r_", ",", "c_"}], "]"}], ":=", 
    RowBox[{"c", "-", "r"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tout", "[", 
    RowBox[{
     RowBox[{"r_", "?", "NumericQ"}], ",", "c_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eps", "=", 
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}]}], "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"r", "<", 
        RowBox[{"rh", "-", "eps"}]}], ",", 
       RowBox[{"c", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Int", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "r"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
          RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}], ",", 
       RowBox[{"r", ">", 
        RowBox[{"rh", "+", "eps"}]}], ",", 
       RowBox[{"c", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Int", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", 
            RowBox[{"rh", "-", "eps"}]}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
          RowBox[{"MaxRecursion", "->", "20"}]}], "]"}], "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Int", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"rh", "+", "eps"}], ",", "r"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
          RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}], ",", "True", ",", 
       "Indeterminate"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Constantes", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cs", "=", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "10", ",", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Singularidad", " ", 
    RowBox[{"(", 
     RowBox[{"r", "\[TildeTilde]", "0"}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"singularity", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0.03", "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"10", " ", "t"}], "]"}]}], ",", "t"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "4"}], ",", "4", ",", "0.1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "Gr\[AAcute]fico", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"GB5Din", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "@", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tout", "[", 
          RowBox[{"r", ",", "c"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "cs"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"tin", "[", 
          RowBox[{"r", ",", "c"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "cs"}], "}"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0.1", ",", "4"}], "}"}], ",", 
    RowBox[{"Exclusions", "->", 
     RowBox[{"{", 
      RowBox[{"r", "==", "rh"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}]}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"FontSize", "->", "16"}], "]"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", "r", "]"}], ",", "18"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", "Singularity", "]"}], ",", "18"}], 
        "]"}]}], "}"}]}], ",", 
    RowBox[{"FrameTicks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"None", ",", "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"rh", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(r\\), \\(h\\)]\\)\>\"", ",",
               "12"}], "]"}]}], "}"}], "}"}], ",", "None"}], "}"}]}], "}"}]}],
     ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.8", "]"}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "cs", "]"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.8", "]"}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "cs", "]"}], "}"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "rh", "}"}], ",", "None"}], "}"}]}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Black", ",", "Thick", ",", 
         RowBox[{"Line", "[", "singularity", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dashed", ",", "Thick", ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rh", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"rh", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
