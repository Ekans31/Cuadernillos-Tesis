Cell[CellGroupData[{

Cell["Observador fuera del agujero negro", "Subsection",
 CellChangeTimes->{{3.983006004812729*^9, 
  3.9830060227802734`*^9}},ExpressionUUID->"e37ea053-0629-2047-abe9-\
76b13c897c72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rh", "=", 
   RowBox[{"r", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "+", 
        RowBox[{"r", "^", "2"}], "-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Coordenada", " ", "tortuga", " ", "como", " ", "soluci\[OAcute]n", " ", 
    "de", " ", "EDO"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rStarFunc", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "r", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"r", "^", "2"}], "-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"rh", "+", "0.001"}], "]"}], "==", "0"}]}], "}"}], ",", "y",
       ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"rh", "+", "0.000001"}], ",", "10"}], "}"}], ",", 
      RowBox[{"MaxStepSize", "->", "0.01"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rayos", " ", "de", " ", 
     RowBox[{"luz", ":", "t"}]}], "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "r"}], "*", 
     RowBox[{"+", "c"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"GB5Dout", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"rStarFunc", "[", "r", "]"}], "+", "c"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"rStarFunc", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"-", "15"}], ",", "15", ",", "1"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "4"}], "}"}], ",", 
    RowBox[{"Exclusions", "->", 
     RowBox[{"{", 
      RowBox[{"r", "==", "rh"}], "}"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}]}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{"FontFamily", "->", "\"\<Times\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"FontSize", "->", "16"}], "]"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", "r", "]"}], ",", "18"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"TraditionalForm", "[", "Singularity", "]"}], ",", "18"}], 
         "]"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"FrameTicks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"None", ",", "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"rh", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(h\)]\)\>\"", ",", 
              "12"}], "]"}]}], "}"}], "}"}], ",", "None"}], "}"}]}], "}"}]}], 
    ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
