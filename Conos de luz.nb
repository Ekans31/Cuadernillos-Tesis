          ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"-", "20"}], ",", "20", ",", "1"}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{
