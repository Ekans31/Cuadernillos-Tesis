        RowBox[{
         RowBox[{"Int", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"rOuter", "+", "eps"}], ",", "r"}], "}"}]}], "]"}], ",", 
       "True", ",", "Indeterminate"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\n", 
