Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "m\[EAcute]trica", " ", "de", " ", "tercer", " ", 
    "orden"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "+", 
    SuperscriptBox["r", "2"], "-", 
    FractionBox[
     RowBox[{"101", " ", 
      SuperscriptBox["r", "4"]}], 
     RowBox[{
      SuperscriptBox["7", 
       RowBox[{"1", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1085"}], " ", 
          SuperscriptBox["r", "6"]}], "-", 
         RowBox[{"1134", " ", 
          SuperscriptBox["r", "2"], " ", "\[Mu]"}], "+", 
         RowBox[{"18", " ", 
          SqrtBox["7"], " ", 
          SuperscriptBox["r", "2"], " ", 
          SqrtBox[
           RowBox[{
            RowBox[{"3699", " ", 
             SuperscriptBox["r", "8"]}], "+", 
            RowBox[{"1085", " ", 
             SuperscriptBox["r", "4"], " ", "\[Mu]"}], "+", 
            RowBox[{"567", " ", 
             SuperscriptBox["\[Mu]", "2"]}]}]]}]}], ")"}], 
       RowBox[{"1", "/", "3"}]]}]], "+", 
    RowBox[{
     FractionBox["1", "7"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "7595"}], " ", 
         SuperscriptBox["r", "6"]}], "-", 
        RowBox[{"7938", " ", 
         SuperscriptBox["r", "2"], " ", "\[Mu]"}], "+", 
        RowBox[{"126", " ", 
         SqrtBox["7"], " ", 
         SuperscriptBox["r", "2"], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"3699", " ", 
            SuperscriptBox["r", "8"]}], "+", 
           RowBox[{"1085", " ", 
            SuperscriptBox["r", "4"], " ", "\[Mu]"}], "+", 
           RowBox[{"567", " ", 
            SuperscriptBox["\[Mu]", "2"]}]}]]}]}], ")"}], 
      RowBox[{"1", "/", "3"}]]}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Buscar", " ", "ambas", " ", "ra\[IAcute]ces"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"horizons", "=", 
   RowBox[{"r", "/.", " ", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "r", "]"}], "==", "0"}], "&&", 
       RowBox[{"r", "<", "10"}], "&&", 
