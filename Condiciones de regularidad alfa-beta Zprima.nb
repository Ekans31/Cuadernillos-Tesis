Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "r2_", "]"}], ":=", 
  RowBox[{"1", "+", 
   SuperscriptBox["r2", "2"], "+", 
   FractionBox[
    SuperscriptBox["r2", 
     RowBox[{"10", "/", "3"}]], 
    RowBox[{
     SqrtBox["3"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         SqrtBox["3"], " ", "\[Mu]2"}], "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["r2", "8"]}], "+", 
          RowBox[{"27", " ", 
           SuperscriptBox["\[Mu]2", "2"]}]}]]}], ")"}], 
      RowBox[{"1", "/", "3"}]]}]], "+", 
