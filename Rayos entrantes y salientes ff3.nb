Notebook[{

Cell[CellGroupData[{
Cell["Rayos de luz en d=5", "Title",
 CellChangeTimes->{{3.980548411419058*^9, 
  3.980548422219528*^9}},ExpressionUUID->"43bf632d-217f-a947-b846-\
879268fe5980"],

Cell[CellGroupData[{

Cell["Schwarzschild", "Section",
 CellChangeTimes->{{3.98054843868067*^9, 
  3.980548449499613*^9}},ExpressionUUID->"78c57c3d-830f-2540-be10-\
1f7fac352997"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Mu]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fSch", "[", "r_", "]"}], ":=", 
  RowBox[{"1", "-", 
   RowBox[{"\[Mu]", "/", 
    RowBox[{"(", 
     RowBox[{"3", 
      RowBox[{"r", "^", "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"fSch", "[", "r", "]"}]}], ",", "r"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9805485335597153`*^9, 3.98054864072497*^9}, {
  3.980548734425823*^9, 3.9805487349669533`*^9}, {3.980548813395668*^9, 
  3.9805488195952663`*^9}},
 CellLabel->
  "In[298]:=",ExpressionUUID->"813c4408-5c6f-ee49-be3f-f3c092bdc83f"],

Cell[BoxData[
 RowBox[{"r", "-", 
  FractionBox[
   RowBox[{
    SqrtBox["\[Mu]"], " ", 
    RowBox[{"ArcTanh", "[", 
     FractionBox[
      RowBox[{
       SqrtBox["3"], " ", "r"}], 
      SqrtBox["\[Mu]"]], "]"}]}], 
   SqrtBox["3"]]}]], "Output",
 CellChangeTimes->{{3.9805486250563736`*^9, 3.980548641364811*^9}, 
   3.980548735952553*^9, 3.9805488202619705`*^9, 3.9805489774452286`*^9, 
   3.980549332261883*^9},
 CellLabel->
  "Out[300]=",ExpressionUUID->"94fde9cc-6440-5842-bea0-96ba6a350ba7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definici\[OAcute]n", " ", "de", " ", "par\[AAcute]metros"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Mu]", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Masa", " ", "del", " ", "agujero", " ", "negro"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rs", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Mu]", "/", "3"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radio", " ", "de", " ", "Schwarzschild"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Coordenada", " ", "de", " ", "tortuga", " ", "r", "*"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSrStar", "[", "r_", "]"}], ":=", 
    RowBox[{"r", "-", 
     RowBox[{
      RowBox[{"(", "rs", ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "-", "rs"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"r", "+", "rs"}], ")"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Trayectorias", " ", "de", " ", "luz", " ", "en", " ", "Schwarzschild", " ", 
     RowBox[{"(", 
      RowBox[{"t", " ", "vs", " ", "r"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"t", "=", 
     RowBox[{
      RowBox[{"constant", "\\", "pm"}], " ", "r", "*"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotSchwarzschild", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rStar", "[", "r", "]"}], "+", "c"}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"rStar", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"-", "10"}], ",", "10", ",", "2"}], "}"}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "4"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", "Thin"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", "Thin"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<r\>\"", ",", "\"\<t\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Rayos de luz en coordenadas de Schwarzschild\>\""}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Black", ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rs", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.980548474548609*^9, 3.980548491483696*^9}, {
  3.980548835028387*^9, 3.9805489916731396`*^9}, {3.980549107211952*^9, 
  3.980549117978405*^9}, {3.980549185695017*^9, 3.9805492017786274`*^9}, {
