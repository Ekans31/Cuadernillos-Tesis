Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "0.358787182711"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "m\[EAcute]trica", " ", "de", " ", "tercer", " ", 
    "orden"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "+", 
    SuperscriptBox["r", "2"], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["r", 
       RowBox[{"2", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1085"}], " ", 
          SuperscriptBox["r", "4"]}], "+", 
         RowBox[{"18", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "63"}], " ", "\[Mu]"}], "+", 
            RowBox[{
             SqrtBox["7"], " ", 
             SqrtBox[
              RowBox[{
               RowBox[{"3699", " ", 
                SuperscriptBox["r", "8"]}], "+", 
               RowBox[{"1085", " ", 
                SuperscriptBox["r", "4"], " ", "\[Mu]"}], "+", 
               RowBox[{"567", " ", 
                SuperscriptBox["\[Mu]", "2"]}]}]]}]}], ")"}]}]}], ")"}], 
       RowBox[{"1", "/", "3"}]]}], 
     SuperscriptBox["7", 
      RowBox[{"2", "/", "3"}]]], "-", 
    FractionBox[
     RowBox[{"101", " ", 
      SuperscriptBox["r", 
       RowBox[{"10", "/", "3"}]]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "7595"}], " ", 
         SuperscriptBox["r", "4"]}], "+", 
        RowBox[{"126", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "63"}], " ", "\[Mu]"}], "+", 
           RowBox[{
            SqrtBox["7"], " ", 
            SqrtBox[
             RowBox[{
              RowBox[{"3699", " ", 
               SuperscriptBox["r", "8"]}], "+", 
              RowBox[{"1085", " ", 
               SuperscriptBox["r", "4"], " ", "\[Mu]"}], "+", 
              RowBox[{"567", " ", 
               SuperscriptBox["\[Mu]", "2"]}]}]]}]}], ")"}]}]}], ")"}], 
      RowBox[{"1", "/", "3"}]]]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Buscar", " ", "la", " ", "ra\[IAcute]z"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"rh", "=", 
  RowBox[{"r", "/.", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "r", "]"}], "==", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0.5"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"scale", "=", "10"}], "\n", 
 RowBox[{
  RowBox[{"rStar", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "r", "]"}], "==", 
        RowBox[{"1", "/", 
         RowBox[{"f", "[", "r", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"rh", "+", "eps"}], "]"}], "==", "0"}]}], "}"}], ",", "y", ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"rh", "+", "eps"}], ",", "4"}], "}"}], ",", 
     RowBox[{"MaxStepSize", "->", "0.001"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plotExtreme", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"scale", "*", 
           RowBox[{"rStarExt", "[", "r", "]"}]}], "+", "c"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "scale"}], "*", 
           RowBox[{"rStarExt", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"-", "15"}], ",", "15", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", 
      RowBox[{"rh", "+", "0.001"}], ",", 
      RowBox[{"rh", "+", "1"}]}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
