Cell["Gauss-Bonnet 5D", "Section",
 CellChangeTimes->{{3.9829310467047253`*^9, 
  3.9829310521663094`*^9}},ExpressionUUID->"3402120f-a01a-8d4d-82bf-\
77d91ead1a33"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{3.9829311181946545`*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"f6a8ff01-d699-f847-97a2-83f3dde8d919"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "2"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Funci\[OAcute]n", " ", "m\[EAcute]trica", " ", "Gauss"}], "-", 
    RowBox[{"Bonnet", " ", 
     RowBox[{"(", 
      RowBox[{"rama", " ", "f\[IAcute]sica"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "r_", "]"}], ":=", 
    RowBox[{"1", "+", 
     RowBox[{"r", "^", "2"}], "-", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"r", "^", "4"}], "+", "\[Mu]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Encontrar", " ", "el", " ", "horizonte"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"rh", "=", 
  RowBox[{"r", "/.", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "r", "]"}], "==", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Coordenada", " ", "tortuga", " ", "como", " ", "soluci\[OAcute]n", " ", 
    "de", " ", "EDO"}], "*)"}], 
  RowBox[{
   RowBox[{"rStarFunc", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "r", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"f", "[", "r", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"rh", "+", "0.001"}], "]"}], "==", "0"}]}], "}"}], ",", "y",
       ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"rh", "+", "0.000001"}], ",", "10"}], "}"}], ",", 
      RowBox[{"MaxStepSize", "->", "0.01"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rayos", " ", "de", " ", 
     RowBox[{"luz", ":", "t"}]}], "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "r"}], "*", 
     RowBox[{"+", "c"}]}]}], "*)"}], 
  RowBox[{"plotGB", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rStarFunc", "[", "r", "]"}], "+", "c"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"rStarFunc", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"-", "15"}], ",", "15", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"rh", "+", "0.001"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Thin"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Thin"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", "\"\<t\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Rayos de luz (Gauss-Bonnet)\>\""}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Black", ",", 
        RowBox[{"InfiniteLine", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rh", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}]}]}], "Input",
