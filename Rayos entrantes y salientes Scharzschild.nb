 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "+", 
    SuperscriptBox["r", "2"], "-", 
    FractionBox[
     RowBox[{"101", " ", 
      SuperscriptBox["r", "4"]}], 
     RowBox[{
      SuperscriptBox["7", 
       RowBox[{"1", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1085"}], " ", 
