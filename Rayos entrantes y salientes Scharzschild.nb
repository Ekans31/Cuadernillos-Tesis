          RowBox[{"c", ",", "constants"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"rMinus", "+", "0.01"}], ",", 
        RowBox[{"rPlus", "-", "0.01"}]}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
