Cell[CellGroupData[{
Cell["Conos de luz", "Title",
 CellChangeTimes->{{3.9829308684678745`*^9, 
  3.982930876265606*^9}},ExpressionUUID->"cab06e96-8bb6-5742-b9a2-\
cb479f10f89a"],

Cell[CellGroupData[{

Cell["Schwarzschild 5D", "Section",
 CellChangeTimes->{{3.982930890766527*^9, 
  3.9829309044717255`*^9}},ExpressionUUID->"7ed0fc2c-9b7d-834b-b959-\
c892ea2b0b11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definici\[OAcute]n", " ", "de", " ", "par\[AAcute]metros"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Mu]", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Masa", " ", "del", " ", "agujero", " ", "negro"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rh", "=", 
     RowBox[{"Sqrt", "[", "\[Mu]", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radio", " ", "del", " ", "Horizonte"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Coordenada", " ", "de", " ", "tortuga", " ", "r", "*"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rStar", "[", "r_", "]"}], ":=", 
     RowBox[{"r", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rh", "/", "2"}], ")"}], "*", 
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "rh"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"r", "+", "rh"}], ")"}]}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Trayectorias", " ", "de", " ", "luz", " ", "en", " ", "Schwarzschild", " ",
      "5", "D", 
     RowBox[{"(", 
      RowBox[{"t", " ", "vs", " ", "r"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"t", "=", 
     RowBox[{
      RowBox[{"constant", "\\", "pm"}], " ", "r", "*"}]}], "*)"}], "\n", 
   RowBox[{"plotSchwarzschild5D", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rStar", "[", "r", "]"}], "+", "c"}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"rStar", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"-", "10"}], ",", "10", ",", "1"}], "}"}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", "Thin"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", "Thin"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<r\>\"", ",", "\"\<t\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Rayos de luz en coordenadas de Schwarzschild\>\""}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Black", ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rh", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{
  3.975170466040024*^9, {3.9751709572391205`*^9, 3.9751709826753826`*^9}, 
   3.97517111512549*^9, {3.980538841045437*^9, 3.9805388585098457`*^9}, {
