            RowBox[{"-", 
             RowBox[{"rStarI", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "constants"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "rPlus", ",", "10"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", "Thin"}], "]"}], ",", 
