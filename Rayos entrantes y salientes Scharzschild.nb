Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definici\[OAcute]n", " ", "de", " ", "par\[AAcute]metros"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"M", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Masa", " ", "del", " ", "agujero", " ", "negro"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rs", "=", 
     RowBox[{"2", "*", "M"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radio", " ", "de", " ", "Schwarzschild"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Coordenada", " ", "de", " ", "tortuga", " ", "r", "*"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rStar", "[", "r_", "]"}], ":=", 
     RowBox[{"r", "+", 
      RowBox[{"rs", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"r", "/", "rs"}], "-", "1"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Trayectorias", " ", "de", " ", "luz", " ", "en", " ", "Schwarzschild", " ", 
     RowBox[{"(", 
      RowBox[{"t", " ", "vs", " ", "r"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"t", "=", 
     RowBox[{
      RowBox[{"constant", "\\", "pm"}], " ", "r", "*"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotSchwarzschild", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rStar", "[", "r", "]"}], "+", "c"}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"rStar", "[", "r", "]"}]}], "+", "c"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"-", "10"}], ",", "10", ",", "2"}], "}"}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", "Thin"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", "Thin"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<r\>\"", ",", "\"\<t\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Rayos de luz en coordenadas de Schwarzschild\>\""}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Black", ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rs", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
