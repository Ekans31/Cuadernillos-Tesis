Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", "Par\[AAcute]metros", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", "0.6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alpha", "=", "0.2"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Funci\[OAcute]n", " ", "m\[EAcute]trica", " ", "Gauss"}], "-", 
    RowBox[{"Bonnet", " ", 
     RowBox[{"(", 
      RowBox[{"rama", " ", "f\[IAcute]sica"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "r_", "]"}], ":=", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "alpha"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"8", " ", "alpha", " ", "M"}], ")"}], "/", 
           RowBox[{"r", "^", "3"}]}]}], "]"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Encontrar", " ", "horizontes"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"roots", "=", 
    RowBox[{"r", "/.", " ", 
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"f", "[", "r", "]"}], "==", "0"}], "&&", 
        RowBox[{"r", ">", "0"}]}], ",", "r"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "roots", "]"}], "<", "2"}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<No hay dos horizontes para estos par\[AAcute]metros.\
\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rMinus", "=", 
   RowBox[{"Min", "[", "roots", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rPlus", "=", 
    RowBox[{"Max", "[", "roots", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Horizonte de Cauchy r_- = \>\"", ",", "rMinus"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Horizonte de eventos r_+ = \>\"", ",", "rPlus"}], "]"}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Construcci\[OAcute]n", " ", "de", " ", "coordenada", " ", "tortuga", " ", 
    "por", " ", "regiones"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Regi\[OAcute]n", " ", 
    RowBox[{"I", ":", 
     RowBox[{"r", ">", 
      RowBox[{"r", "+"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rStarI", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"rstar", "'"}], "[", "r", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"f", "[", "r", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"rstar", "[", 
          RowBox[{"rPlus", "+", "0.1"}], "]"}], "==", "0"}]}], "}"}], ",", 
      "rstar", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"rPlus", "+", "0.1"}], ",", "10"}], "}"}]}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Regi\[OAcute]n", " ", 
    RowBox[{"II", ":", 
     RowBox[{
      RowBox[{"r", "-"}], " ", "<", "r", "<", 
      RowBox[{"r", "+"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rStarII", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"rstar", "'"}], "[", "r", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"f", "[", "r", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"rstar", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rPlus", "+", "rMinus"}], ")"}], "/", "2"}], "]"}], "==", 
         "0"}]}], "}"}], ",", "rstar", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"rMinus", "+", "0.01"}], ",", 
        RowBox[{"rPlus", "-", "0.01"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Regi\[OAcute]n", " ", 
    RowBox[{"III", ":", 
     RowBox[{"r", "<", 
      RowBox[{"r", "-"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rStarIII", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"rstar", "'"}], "[", "r", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"f", "[", "r", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"rstar", "[", 
          RowBox[{"rMinus", "-", "0.1"}], "]"}], "==", "0"}]}], "}"}], ",", 
      "rstar", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0.05", ",", 
        RowBox[{"rMinus", "-", "0.1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Familia", " ", "de", " ", "constantes"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"constants", "=", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "20"}], ",", "20", ",", "2"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gr\[AAcute]ficos", " ", "por", " ", "regi\[OAcute]n"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotI", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rStarI", "[", "r", "]"}], "+", "c"}], ",", 
