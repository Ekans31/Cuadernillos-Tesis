     RowBox[{"\[Nu]", "=", "0"}], ",", 
     RowBox[{"\[Nu]", "<", "len"}], ",", 
     RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"\[Sigma]", "=", "0"}], ",", 
       RowBox[{"\[Sigma]", "<", "len"}], ",", 
       RowBox[{"\[Sigma]", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"\[Rho]", "=", "0"}], ",", 
         RowBox[{"\[Rho]", "<", "len"}], ",", 
         RowBox[{"\[Rho]", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RiemUDDD", "[", 
            RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], 
            "]"}], "=", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"\[CapitalGamma]", "[", 
                RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "\[Nu]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"x", "[", "\[Mu]", "]"}], "/.", "r1"}], "/.", 
                  "r2"}], "/.", "r3"}], "/.", "r4"}]}], "]"}], "-", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"\[CapitalGamma]", "[", 
                RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "\[Mu]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"x", "[", "\[Nu]", "]"}], "/.", "r1"}], "/.", 
                  "r2"}], "/.", "r3"}], "/.", "r4"}]}], "]"}], "+", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalGamma]", "[", 
                 RowBox[{"\[Rho]", ",", "\[Lambda]", ",", "\[Mu]"}], "]"}], "*",
                 " ", 
                RowBox[{"\[CapitalGamma]", "[", 
                 RowBox[{"\[Lambda]", ",", "\[Sigma]", ",", "\[Nu]"}], 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Lambda]", ",", "0", ",", 
                 RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}], "-", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalGamma]", "[", 
                 RowBox[{"\[Rho]", ",", "\[Lambda]", ",", "\[Nu]"}], "]"}], "*",
                 " ", 
                RowBox[{"\[CapitalGamma]", "[", 
                 RowBox[{"\[Lambda]", ",", "\[Sigma]", ",", "\[Mu]"}], 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Lambda]", ",", "0", ",", 
                 RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
