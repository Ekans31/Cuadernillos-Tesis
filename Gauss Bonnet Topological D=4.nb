Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"\[Mu]", "=", "0"}], ",", 
   RowBox[{"\[Mu]", "<", "len"}], ",", 
   RowBox[{"\[Mu]", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"\[Nu]", "=", "0"}], ",", 
     RowBox[{"\[Nu]", "<", "len"}], ",", 
     RowBox[{"\[Nu]", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "=", "0"}], ",", 
       RowBox[{"\[Rho]", "<", "len"}], ",", 
       RowBox[{"\[Rho]", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalGamma]", "[", 
          RowBox[{"\[Rho]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "=", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{
            FractionBox["1", "2"], " ", "*", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"gup", "[", 
                RowBox[{"\[Rho]", ",", "\[Sigma]"}], "]"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"gdown", "[", 
                    RowBox[{"\[Nu]", ",", "\[Sigma]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", "\[Mu]", "]"}], "/.", "r1"}], "/.", 
                    "r2"}], "/.", "r3"}], "/.", "r4"}]}], "]"}], "+", 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"gdown", "[", 
                    RowBox[{"\[Sigma]", ",", "\[Mu]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", "\[Nu]", "]"}], "/.", "r1"}], "/.", 
                    "r2"}], "/.", "r3"}], "/.", "r4"}]}], "]"}], "-", 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"gdown", "[", 
                    RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", "\[Sigma]", "]"}], "/.", "r1"}], "/.", 
                    "r2"}], "/.", "r3"}], "/.", "r4"}]}], "]"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"\[Sigma]", ",", "0", ",", 
                RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Epsilon]", ",", "0", ",", "2"}], "}"}]}], "]"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9864920295651875`*^9, 3.986492036144581*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"3edd2981-4208-f54b-89d3-945d867652c7"]
}, Closed]],

